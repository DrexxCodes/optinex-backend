# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Analytics day/month/year keys use this process's LOCAL date. Set it to the timezone the Next.js servers
# used so day boundaries don't shift (UTC if they ran on Vercel).
TZ=UTC

# true when the backend sits behind the Next.js /api rewrite or a load balancer, so rate limits see the
# real client IP (X-Forwarded-For). Leave false if clients can reach the backend directly.
TRUST_PROXY=true
# Only needed if a browser ever calls the backend cross-origin. Same-origin via the Next rewrite needs none.
CORS_ORIGINS=

# ─── Session cookies ───────────────────────────────────────────────────────
# Defaults to true in production. Set false only for plain-http local testing of a production build.
COOKIE_SECURE=
# Leave empty so cookies stay host-only on each app (recommended).
COOKIE_DOMAIN=

# ─── Supabase (the ONLY service that holds these) ──────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Upstash Redis ─────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Firebase Admin (push delivery only) ───────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Paystack / UploadThing / cron ─────────────────────────────────────────
PAYSTACK_SECRET_KEY=
UPLOADTHING_TOKEN=
# Public URL UploadThing calls when an upload finishes = <user app domain>/api/uploadthing
UPLOADTHING_CALLBACK_URL=
# Bearer secret for the legacy /api/cron/investment-returns route. Empty = route is closed.
CRON_SECRET=

# ─── Abuse protection (defaults shown) ─────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=300          # requests/min per IP, all routes
RATE_LIMIT_USER_MAX=240            # requests/min per signed-in user
RATE_LIMIT_SIGNIN_MAX=30           # sign-ins/min per IP
RATE_LIMIT_SIGNIN_EMAIL_MAX=10     # sign-ins/15 min per email, across all IPs
RATE_LIMIT_SIGNUP_MAX=20           # sign-ups/hour per IP
RATE_LIMIT_REFRESH_MAX=60          # session refreshes/min per IP
RATE_LIMIT_BAN_AFTER=25            # auth routes: 403 for the window after N over-limit hits (0 = off)
BODY_LIMIT_BYTES=100000
