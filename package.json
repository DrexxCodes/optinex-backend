{
  "name": "optinex-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Fastify backend for optinex-user and optinex-admin. The only service that talks to Supabase, Upstash Redis, FCM, Paystack and UploadThing.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dicebear/collection": "9.4.3",
    "@dicebear/core": "9.4.3",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@supabase/supabase-js": "^2.119.2",
    "@upstash/redis": "^1.41.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "firebase-admin": "^14.5.1",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
